# ModelForge Environment Variables
# Copy to .env and fill in values

# ── Database ──
# Provider: inmemory | sqlite | postgres (default: inmemory)
DatabaseProvider=postgres
# SQLite path (when DatabaseProvider=sqlite):
# ConnectionStrings__ModelForge=Data Source=modelforge.db
# PostgreSQL (when DatabaseProvider=postgres):
ConnectionStrings__ModelForge=Host=postgres;Database=modelforge;Username=modelforge;Password=modelforge-dev
MODELFORGE_DB_PASSWORD=modelforge-dev

# ── JWT Auth ──
# Minimum 32 characters. Generate: powershell -c "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
MODELFORGE_JWT_SECRET=ModelForge-Production-Secret-ChangeMe-Min32Chars!!

# ── Sidecar ──
MODELFORGE_SIDECAR_URL=http://localhost:5200
MODELFORGE_KEYBOARD_HOOK_ENABLED=true

# ── Backend API ──
MODELFORGE_API_URL=http://localhost:5095

# ── AI (optional) ──
# MODELFORGE_AI_API_KEY=sk-xxx