# ModelForge Environment Variables
# Copy to .env and fill in values

# ── Database ──
# Provider: inmemory | sqlite | postgres (default: inmemory)
DatabaseProvider=postgres
# SQLite path (when DatabaseProvider=sqlite):
# ConnectionStrings__ModelForge=Data Source=modelforge.db
# PostgreSQL (when DatabaseProvider=postgres):
ConnectionStrings__ModelForge=Host=postgres;Database=modelforge;Username=modelforge;Password=modelforge-dev
MODELFORGE_DB_PASSWORD=modelforge-dev

# ── JWT Auth ──
# Minimum 32 characters. Generate: powershell -c "[Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))"
MODELFORGE_JWT_SECRET=ModelForge-Production-Secret-ChangeMe-Min32Chars!!

# ── Sidecar ──
VITE_MODELFORGE_SIDECAR_URL=http://localhost:5200
Sidecar__KeyboardHookEnabled=true
# Optional: protect Sidecar /api/* endpoints. Keep empty for local development.
# Set the same value in Sidecar__LocalApiToken and VITE_MODELFORGE_SIDECAR_TOKEN when enabled.
Sidecar__LocalApiToken=
VITE_MODELFORGE_SIDECAR_TOKEN=

# ── Backend API ──
VITE_MODELFORGE_API_URL=http://localhost:5095
# Optional: Sidecar -> Backend service export token for Corporate Dictionary.
MODELFORGE_SERVICE_TOKEN=
ModelForge__ServiceToken=
Sidecar__ServiceToken=
# Admin audit event retention window in days. Default: 90.
AuditRetentionDays=90

# ── AIWA AI Provider ──
# Provider: mock | ollama | openai-compatible (default: mock, no real API needed)
AIWA__Provider=mock
# Ollama (local):
# AIWA__Provider=ollama
# AIWA__ApiUrl=http://localhost:11434
# AIWA__Model=llama3
# OpenAI-compatible (Agnes, OpenAI, etc.):
# AIWA__Provider=openai-compatible
# AIWA__ApiUrl=https://apihub.agnes-ai.com
# AIWA__ApiKey=sk-xxx
# AIWA__Model=agnes-2.0-flash
# Legacy:
# MODELFORGE_AI_API_KEY=sk-xxx
