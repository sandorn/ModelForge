<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="ModelForgeTab" label="ModelForge">
        <group id="BridgeGroup" label="桥接">
          <button id="PingBackendButton"
                  label="检查后端"
                  size="large"
                  imageMso="HappyFace"
                  onAction="OnPingBackend" />
          <button id="OpenTaskPaneButton"
                  label="打开任务窗格"
                  size="large"
                  imageMso="TaskPaneInsert"
                  onAction="OnOpenTaskPane" />
        </group>
        <group id="PowerToolsGroup" label="Power Tools">
          <button id="FillRightButton" label="向右填充" imageMso="FillRight" onAction="OnDispatchCommand" tag="excel.fill-right" />
          <button id="FillDownButton" label="向下填充" imageMso="FillDown" onAction="OnDispatchCommand" tag="excel.fill-down" />
          <button id="WrapIfErrorButton" label="IFERROR" imageMso="FunctionWizard" onAction="OnDispatchCommand" tag="excel.wrap-iferror" />
        </group>
        <group id="AuditGroup" label="模型审计">
          <button id="ModelCheckButton" label="Model Check" imageMso="ReviewTrackChanges" onAction="OnDispatchCommand" tag="excel.model-check" />
          <button id="PrepareToShareButton" label="安全外发" imageMso="FilePrepareMenu" onAction="OnDispatchCommand" tag="excel.prepare-to-share" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
